#!/usr/bin/env bash
#
# Performs a standard screen lock, with an extra bit of style. Blurs and
# desaturates the desktop background image (as set by feh), and uses that
# as the lock screen background.
#
# Requirements: i3lock imagemagick

out="/tmp/i3-lock-wrapper-$(date "+%s").png"

background="$(readlink -f ~/.desktop-background)"
convert "${background}" -blur 0x4 -modulate 110,50 -resize 5760x1080 "$out"
i3lock -fti "$out"

rm "$out"
